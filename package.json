{
  "name": "tauri-app",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
    "lint": "oxlint -c .oxlintrc.json && eslint .",
    "test": "playwright test",
    "test:unit": "vitest run",
    "coverage:frontend": "vitest run --coverage",
    "coverage:backend": "cd src-tauri && cargo llvm-cov nextest --lcov --output-path ../lcov.info",
    "check:deps": "cd src-tauri && cargo machete",
    "cli": "cd src-tauri && cargo run --quiet --bin taskroot --",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "bits-ui": "^2.21.0",
    "date-fns": "^4.4.0",
    "material-symbols": "^0.46.0",
    "neverthrow": "^8.2.0",
    "svelte-sonner": "^1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.24.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "oxlint-plugin-complexity": "^2.1.8",
    "oxlint-tsgolint": "^7.0.2007",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
